# =========================================================================
# foundry-sme — single source of truth for local + deploy environment.
#
# 1. Copy this file to `.env` at the repo root (`.env` is git-ignored).
# 2. Fill in the values below. Anything left blank will make deploy /
#    demo scripts fail loudly rather than silently pointing at the wrong
#    tenant.
# 3. `scripts/load-env.ps1` dot-sources this file into your current
#    PowerShell session — every demo-*.ps1 and deploy script reads from
#    the same variables.
# =========================================================================

# ---------- Azure subscription / tenant ----------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=centralus
AZURE_RESOURCE_GROUP=rg-sme

# ---------- SQL logical server -------------------------------------------
SQL_SERVER_NAME=sql-server-sme
SQL_DATABASE_NAME=sql-db-sme

# Entra ID admin on the SQL server (typically the deploying user).
# Object id + login are BOTH required — SQL AAD-only auth needs both.
AAD_ADMIN_OBJECT_ID=00000000-0000-0000-0000-000000000000
AAD_ADMIN_LOGIN=admin@contoso.onmicrosoft.com
AAD_ADMIN_PRINCIPAL_TYPE=User          # User | Group | Application

# ---------- AI Foundry account / project ---------------------------------
FOUNDRY_ACCOUNT_NAME=ai-foundry-sme
FOUNDRY_PROJECT_NAME=proj-sme
FOUNDRY_PROJECT_DISPLAY_NAME=SME Triage Demo
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o
FOUNDRY_MODEL_NAME=gpt-4o
FOUNDRY_MODEL_VERSION=2024-11-20

# Foundry project MI object id — populated after `az deployment` runs
# `foundry.bicep` (from outputs.foundryProjectPrincipalId). This is the
# principal Easy Auth on the Function App gates on.
FOUNDRY_PROJECT_MI_OBJECT_ID=

# ---------- Function App -------------------------------------------------
FUNCTION_APP_NAME=func-sme
FUNCTION_APP_AUDIENCE=api://func-sme
FUNCTION_APP_BASE_URL=https://func-sme.azurewebsites.net

# ---------- Monitored mailbox --------------------------------------------
# UPN of a mailbox in your tenant. The Function App poller reads unread
# [BI-DEMO] messages from this inbox every 30 seconds.
MAILBOX_UPN=bi-triage-demo@yourtenant.onmicrosoft.com

# ---------- Power BI target ----------------------------------------------
# Workspace and dataset the Triage agent refreshes. The Foundry project MI
# must be added to the workspace as Contributor.
PBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
PBI_DATASET_ID=00000000-0000-0000-0000-000000000000

# ---------- Teams webhook (Power Automate Workflows) ---------------------
# Create with the "Post to a channel when a webhook request is received"
# Workflows template inside Teams. The resulting URL contains a signed
# `sig=` query parameter — treat it as a secret.
#
# `agents/deploy-agents.ps1` templates this URL into the Teams webhook
# OpenAPI spec at deploy time.
TEAMS_WEBHOOK_URL=

# ---------- Cockpit optional --------------------------------------------
FOUNDRY_PROJECT_URL=https://ai.azure.com/
POLL_INTERVAL_SEC=2
