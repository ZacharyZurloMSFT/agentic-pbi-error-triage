# Copy to cockpit\.env and adjust as needed. dotenv is loaded on startup.

# Function App (VNet-side broker for SQL + Graph reads)
FUNCTION_URL=https://func-sme.azurewebsites.net
FUNCTION_AUDIENCE=api://func-sme

# For display only — actual mailbox reads happen inside func-sme using its MI.
MAILBOX_UPN=bi-triage-demo@yourtenant.onmicrosoft.com

# Optional: deep-link to Foundry project (used by the "Open trace" links)
FOUNDRY_PROJECT_URL=https://ai.azure.com/

# Cockpit polling knob (seconds)
POLL_INTERVAL_SEC=2

# Optional: pin AzureCliCredential to a specific tenant if the presenter's
# az CLI is signed into multiple tenants at once.
# AZURE_TENANT_ID=

# ----- Power BI target (surfaced to the browser via /api/config) ---------
# Replace with the workspace + dataset the demo hits. All copy-pasteable
# email templates in cockpit/static/cockpit.js read these at page load.
PBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
PBI_DATASET_ID=00000000-0000-0000-0000-000000000000
